[Unit]
Description=Phantom VPN Telegram Bot (@coinraterobot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/phantom-vpn-bot
EnvironmentFile=/opt/phantom-vpn-bot/.env
ExecStart=/opt/phantom-vpn-bot/venv/bin/python /opt/phantom-vpn-bot/bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
